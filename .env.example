# PostgreSQL connection (required for app + migrations)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"

# JWT signing secret — min 16 characters; use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-key"

# If the site is served over HTTP in production (no HTTPS), set this so the session cookie is saved:
# SESSION_COOKIE_INSECURE=1

# Public site URL (used for absolute links in emails/SEO if extended; uploads use relative /uploads locally)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hero text (optional)
NEXT_PUBLIC_HERO_NAME="Your Name"
NEXT_PUBLIC_HERO_TITLE="Backend Developer"

# Optional: 404 page — large name (space-separated words animate one-by-one). Default: PARTH BHARDWAJ
# NEXT_PUBLIC_NOT_FOUND_NAME="PARTH BHARDWAJ"

# Optional: résumé PDF URL — same buttons as Admin → About → Résumé (DB wins if both set)
# NEXT_PUBLIC_RESUME_URL="https://example.com/Parth-Resume.pdf"

# Optional: shows mail icon in nav sidebar (mailto:)
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"

# Optional: skills section title + footer name
# NEXT_PUBLIC_SKILLS_HEADING="Technical skills"
# NEXT_PUBLIC_FOOTER_NAME="Your Name"

# -----------------------------------------------------------------------------
# Uploads (admin → portfolio / profile images & videos)
# -----------------------------------------------------------------------------
# The database stores only URL strings (not file bytes). Files must live on disk or a host.
#
# local      = public/uploads on this machine (OK for local dev; on VPS with persistent disk only)
# cloudinary = hosted media — recommended for Vercel/Netlify/Railway deploys (set vars below)
# s3         = S3-compatible bucket (e.g. storageapi.dev) when you want your own object storage
#
# If CLOUDINARY_URL (or the three CLOUDINARY_* keys) is set, uploads use Cloudinary even when this
# line is omitted. Set UPLOAD_PROVIDER=local to force disk uploads while testing.
UPLOAD_PROVIDER="local"

# --- Cloudinary admin uploads (local or deploy) ---
# UPLOAD_PROVIDER="cloudinary"
# One line from Cloudinary dashboard (Upload tab → API environment variable):
# CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"
# Example shape (replace with your real key/secret/cloud):
# CLOUDINARY_URL="cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz@dof7reunt"
# Optional folder prefix inside Cloudinary:
# CLOUDINARY_FOLDER="portfolio"

# --- S3-compatible (required when UPLOAD_PROVIDER=s3) ---
# API endpoint from your bucket dashboard (no trailing slash)
S3_ENDPOINT="https://t3.storageapi.dev"
# Bucket name
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Region from dashboard (e.g. auto). If uploads fail, try: us-east-1
S3_REGION="auto"
# Optional: prefix inside the bucket (no leading/trailing slashes)
S3_KEY_PREFIX="portfolio"
# Virtual-hosted public URL is built as https://{S3_BUCKET}.{host}/key
# If your provider uses path-style or a CDN, set the full base URL instead (no trailing slash):
# S3_PUBLIC_BASE_URL="https://your-bucket.t3.storageapi.dev"
# Force path-style API (some MinIO-style setups). Default: unset (virtual-hosted)
# S3_FORCE_PATH_STYLE=1

# Next.js <Image /> — extra allowed host (S3/CDN custom domain). Cloudinary uses res.cloudinary.com by default.
# Example: my-bucket.t3.storageapi.dev
NEXT_PUBLIC_IMAGE_HOSTNAME=""

# Cloudinary — use CLOUDINARY_URL above OR these three (URL wins if both are set)
# When UPLOAD_PROVIDER=cloudinary, admin image/video/PDF uploads go here.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio"

# -----------------------------------------------------------------------------
# Admin user (used by `npx prisma db seed` and `npm run admin:create`)
# -----------------------------------------------------------------------------
# Recommended: set both. Password must be 8+ characters when NODE_ENV=production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
#
# Legacy aliases (optional — only used if ADMIN_USERNAME / ADMIN_PASSWORD are unset):
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="changeme123"

# Seed: set SEED_DUMMY=0 to skip inserting demo portfolio + contacts when those tables are empty
# SEED_DUMMY=0
