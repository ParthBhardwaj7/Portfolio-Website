# PostgreSQL connection (required for app + migrations)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"

# JWT signing secret — min 16 characters; use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-key"

# Public site URL (used for absolute links in emails/SEO if extended; uploads use relative /uploads locally)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hero text (optional)
NEXT_PUBLIC_HERO_NAME="Your Name"
NEXT_PUBLIC_HERO_TITLE="Backend Developer"

# Optional: shows mail icon in nav sidebar (mailto:)
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"

# Optional: skills section title + footer name
# NEXT_PUBLIC_SKILLS_HEADING="Technical skills"
# NEXT_PUBLIC_FOOTER_NAME="Your Name"

# Uploads: "local" writes to public/uploads; "cloudinary" for Vercel/production
UPLOAD_PROVIDER="local"

# Cloudinary (required when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio"

# Seed script defaults (optional overrides)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"

# Seed: set SEED_DUMMY=0 to skip inserting demo portfolio + contacts when those tables are empty
# SEED_DUMMY=0

# Optional: used by `npm run admin:create` (same as SEED_* if unset)
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="your-secure-password"
