generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Portfolio {
  id             String           @id @default(uuid())
  title          String
  description    String           @db.Text
  /// URL segment for /projects/[slug] detail page; empty = no public detail page.
  slug           String?          @unique
  /// Comma-separated technologies shown as pills (e.g. "Go, Prometheus, Grafana").
  techStack      String?          @db.Text
  image          String?
  link           String?
  /// Live deployment URL shown as "Visit site"; falls back to `link` in UI.
  liveUrl        String?          @db.Text
  /// Short line on the Gallery (visual snapshots) image; optional.
  galleryCaption String?          @db.Text
  /// Looping muted video on Works + Gallery (MP4/WebM URL or /uploads/…); optional.
  videoUrl       String?          @db.Text
  /// Detail page sections — all optional, rendered only when present.
  problem        String?          @db.Text
  solution       String?          @db.Text
  architecture   String?          @db.Text
  /// Featured projects render larger on Works.
  featured        Boolean         @default(false)
  /// Lower renders first on Works.
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  images         PortfolioImage[]
}

/// Timeline entries — only verifiable milestones (projects shipped, credentials earned, OSS merged).
model Experience {
  id           String   @id @default(uuid())
  /// Free-form label, e.g. "2026-04" or "April 2026".
  year         String
  title        String
  org          String?
  /// work | project | certification | opensource | milestone
  type         String   @default("project")
  description  String   @db.Text
  /// Comma-separated technologies.
  technologies String?  @db.Text
  url          String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Extra gallery images attached to a portfolio project.
model PortfolioImage {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  url         String    @db.Text
  caption     String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([portfolioId])
}

model About {
  id             String  @id @default(uuid())
  content        String  @db.Text
  profileImage   String?
  /// Line under hero title (inquiry / contact text).
  heroTagline    String? @db.Text
  /// Text on the contact section photo card overlay.
  contactCaption String? @db.Text
  /// Public PDF URL for "Download résumé" (https://…, Cloudinary raw, or /uploads/…).
  resumeUrl      String? @db.Text
  /// Browser tab icon / Google search left icon (PNG, ICO, SVG — square, min 32×32).
  favicon        String? @db.Text
  /// Open Graph / social-share preview image shown when site is shared or searched (1200×630 recommended).
  ogImage        String? @db.Text
  /// Master switch for the public AI chat widget (bottom-right). Default: off.
  chatEnabled    Boolean @default(false)
}

/// Grouped technical skills (e.g. Programming Languages, Backend Engineering).
model SkillCategory {
  id        String      @id @default(uuid())
  title     String
  sortOrder Int         @default(0)
  items     SkillItem[]
}

/// One pill / line per item; label can be short or a comma-separated phrase.
model SkillItem {
  id         String        @id @default(uuid())
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String        @db.Text
  sortOrder  Int           @default(0)

  @@index([categoryId])
}

model Social {
  id        String  @id @default(uuid())
  github    String?
  linkedin  String?
  instagram String?
  twitter   String?
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  role      String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

/// Security/audit trail: login events + admin mutations.
model AuditLog {
  id        String   @id @default(uuid())
  /// "admin" | "anonymous"
  actor     String
  action    String
  /// e.g. "portfolio", "experience", "auth"
  entity    String
  entityId  String?
  /// Short human-readable detail (no secrets).
  detail    String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

/// Certificate / credential earned by the portfolio owner.
model Certification {
  id            String   @id @default(uuid())
  title         String
  issuer        String
  /// Free-form date string e.g. "March 2024" or "2024-03".
  issueDate     String?
  /// URL of the certificate image (PNG/JPG/WebP).
  imageUrl      String?  @db.Text
  /// URL of the certificate PDF (Cloudinary raw or /uploads/…).
  pdfUrl        String?  @db.Text
  /// External credential verification URL.
  credentialUrl String?  @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}
